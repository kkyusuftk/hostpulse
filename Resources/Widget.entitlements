<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit requires the extension to be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Ad-hoc builds have no team ID, so instead of an App Group the widget gets
	     access to the one folder the app writes its readings to. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/HostPulse/</string>
	</array>
</dict>
</plist>
